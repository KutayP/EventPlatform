@model List<EventListItemViewModel>

@{
    ViewData["Title"] = "Etkinlikler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Yaklaşan etkinlikler</h2>
    @if (User.Identity!.IsAuthenticated)
    {
        <a asp-action="Create" class="btn btn-primary">Etkinlik oluştur</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Şu anda gösterilecek etkinlik yok.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var e in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@e.Category</span>
                        <h5 class="card-title">
                            <a asp-action="Details" asp-route-id="@e.Eventid" class="text-decoration-none text-dark stretched-link">@e.Eventname</a>
                        </h5>
                        <p class="card-text mb-1">📍 @e.Location</p>
                        <p class="card-text text-muted">🗓 <time class="js-local" datetime="@(e.Date.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"))">@e.Date.ToString("dd.MM.yyyy HH:mm") UTC</time></p>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/local-time.js"></script>
}