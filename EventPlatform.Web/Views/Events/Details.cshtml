@model EventDetailsViewModel

@{
    ViewData["Title"] = Model.Eventname;
}

<a asp-action="Index" class="btn btn-link px-0 mb-3">&larr; Etkinliklere dön</a>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <span class="badge bg-secondary mb-2">@Model.Category</span>
        <h2 class="card-title">@Model.Eventname</h2>

        <p class="text-muted mb-1">
            🗓 <time class="js-local" datetime="@(Model.Date.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"))">@Model.Date.ToString("dd.MM.yyyy HH:mm") UTC</time>
            · Süre: @Model.Duration saat
        </p>
        <p class="mb-1">📍 @Model.Location</p>
        <p class="mb-3">👤 Oluşturan: @Model.CreatorUsername · 👥 @Model.ParticipantCount katılımcı</p>

        <h5>Açıklama</h5>
        <p>@Model.Description</p>

        <hr />

        @if (Model.IsPast)
        {
            <span class="text-muted">Bu etkinlik sona erdi.</span>
        }
        else if (!User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Login"
               asp-route-returnUrl="@Url.Action("Details", "Events", new { id = Model.Eventid })"
               class="btn btn-primary">Katılmak için giriş yapın</a>
        }
        else if (Model.IsCreator)
        {
            <span class="badge bg-info text-dark">Bu etkinliği siz oluşturdunuz</span>
        }
        else if (Model.IsParticipant)
        {
            <form asp-action="Leave" asp-route-id="@Model.Eventid" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger">Etkinlikten ayrıl</button>
            </form>
        }
        else
        {
            <form asp-action="Join" asp-route-id="@Model.Eventid" method="post" class="d-inline">
                <button type="submit" class="btn btn-success">Katıl</button>
            </form>
        }
    </div>
</div>

@if (Model.CanChat)
{
    // Geçmiş mesajlar JSON olarak verilir, ekrana JS çizer (canlı mesajlarla aynı kod).
    // JsonSerializer varsayılan olarak <, >, & karakterlerini kaçırır: script etiketi içinde güvenlidir.
    var historyJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Messages.Select(m => new
        {
            id = m.Messageid,
            senderId = m.SenderId,
            sender = m.SenderUsername,
            text = m.Text,
            sentAt = m.SentAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")
        }));

    <div class="card shadow-sm mt-4" id="chatCard" data-event-id="@Model.Eventid" data-user-id="@Model.CurrentUserId">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>💬 Etkinlik sohbeti</span>
            <span id="chatStatus" class="badge bg-secondary">bağlanıyor…</span>
        </div>

        <div class="card-body" id="chatMessages" style="height: 340px; overflow-y: auto;"></div>
        <script type="application/json" id="chatHistory">@Html.Raw(historyJson)</script>

        <div class="card-footer">
            <form id="chatForm" class="d-flex gap-2">
                <input id="chatInput" type="text" class="form-control" maxlength="1000"
                       autocomplete="off" placeholder="Mesaj yazın…" />
                <button type="submit" class="btn btn-primary">Gönder</button>
            </form>
        </div>
    </div>
}
else if (User.Identity!.IsAuthenticated && !Model.IsPast)
{
    <p class="text-muted mt-4">💬 Sohbete katılmak için etkinliğe katılın.</p>
}

@section Scripts {
    <script src="~/js/local-time.js"></script>

    @if (Model.CanChat)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
        <script src="~/js/event-chat.js"></script>
    }
}