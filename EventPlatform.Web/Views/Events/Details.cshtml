@model EventDetailsViewModel

@{
    ViewData["Title"] = Model.Eventname;

    var creatorInitial = Model.CreatorUsername.Length > 0
        ? Model.CreatorUsername.Substring(0, 1).ToUpperInvariant()
        : "?";

    string? mapUrl = null;
    if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        mapUrl = FormattableString.Invariant(
            $"https://www.google.com/maps/search/?api=1&query={Model.Latitude.Value},{Model.Longitude.Value}");
    }

    // Sohbet geçmişi JSON olarak verilir, ekrana JS çizer (canlı mesajlarla aynı kod).
    // JsonSerializer varsayılan olarak <, >, & karakterlerini kaçırır: script etiketi içinde güvenlidir.
    var historyJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Messages.Select(m => new
        {
            id = m.Messageid,
            senderId = m.SenderId,
            sender = m.SenderUsername,
            text = m.Text,
            sentAt = m.SentAt.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'")
        }));
}

<a asp-action="Index" class="text-decoration-none d-inline-block mb-3">
    <i class="bi bi-arrow-left"></i> Etkinliklere dön
</a>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-body p-4">
                <span class="badge category-badge @CategoryStyle.CssClass(Model.Category) mb-3">@CategoryStyle.Label(Model.Category)</span>
                <h1 class="h2 mb-3">@Model.Eventname</h1>

                <div class="d-flex align-items-center gap-2 text-muted mb-4">
                    <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-semibold"
                          style="width: 28px; height: 28px; font-size: 0.8rem;">@creatorInitial</span>
                    <span>Oluşturan: <strong class="text-body">@Model.CreatorUsername</strong></span>
                </div>

                <h2 class="h6 text-uppercase text-muted mb-2">Açıklama</h2>
                <p class="mb-0" style="white-space: pre-line;">@Model.Description</p>
            </div>
        </div>

        @if (Model.CanChat)
        {
            <div class="card" id="chatCard" data-event-id="@Model.Eventid" data-user-id="@Model.CurrentUserId">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-chat-dots"></i> Etkinlik sohbeti</span>
                    <span id="chatStatus" class="badge bg-secondary">bağlanıyor…</span>
                </div>

                <div class="card-body" id="chatMessages" style="height: 380px; overflow-y: auto; background: #fafbff;"></div>
                <script type="application/json" id="chatHistory">@Html.Raw(historyJson)</script>

                <div class="card-footer bg-white">
                    <form id="chatForm" class="d-flex gap-2">
                        <input id="chatInput" type="text" class="form-control" maxlength="1000"
                               autocomplete="off" placeholder="Mesaj yazın…" />
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Gönder</button>
                    </form>
                </div>
            </div>
        }
        else if (User.Identity!.IsAuthenticated && !Model.IsPast)
        {
            <div class="card">
                <div class="card-body text-center text-muted py-4">
                    <i class="bi bi-lock fs-4 d-block mb-2"></i>
                    Sohbet yalnızca etkinliğe katılanlara açık. Sohbete katılmak için etkinliğe katıl.
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card position-sticky" style="top: 5rem;">
            <div class="card-body p-4">
                <div class="d-flex gap-3 mb-3">
                    <i class="bi bi-calendar-event fs-5 text-primary"></i>
                    <div>
                        <div class="fw-semibold">
                            <time class="js-local" datetime="@(Model.Date.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"))">@Model.Date.ToString("dd.MM.yyyy HH:mm") UTC</time>
                        </div>
                        <div class="text-muted small">Süre: @Model.Duration saat</div>
                    </div>
                </div>

                <div class="d-flex gap-3 mb-3">
                    <i class="bi bi-geo-alt fs-5 text-primary"></i>
                    <div>
                        <div>@Model.Location</div>
                        @if (mapUrl != null)
                        {
                            <a href="@mapUrl" target="_blank" rel="noopener noreferrer" class="small text-decoration-none">
                                Haritada aç <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        }
                    </div>
                </div>

                <div class="d-flex gap-3 mb-4">
                    <i class="bi bi-people fs-5 text-primary"></i>
                    <div>@Model.ParticipantCount katılımcı</div>
                </div>

                @if (Model.IsPast)
                {
                    <div class="alert alert-secondary mb-0 text-center">Bu etkinlik sona erdi.</div>
                }
                else if (!User.Identity!.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Details", "Events", new { id = Model.Eventid })"
                       class="btn btn-primary w-100">Katılmak için giriş yap</a>
                }
                else if (Model.IsCreator)
                {
                    <div class="alert alert-info mb-0 text-center">Bu etkinliği sen oluşturdun.</div>
                }
                else if (Model.IsParticipant)
                {
                    <form asp-action="Leave" asp-route-id="@Model.Eventid" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100">Etkinlikten ayrıl</button>
                    </form>
                }
                else
                {
                    <form asp-action="Join" asp-route-id="@Model.Eventid" method="post">
                        <button type="submit" class="btn btn-primary w-100">Etkinliğe katıl</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/local-time.js"></script>

    @if (Model.CanChat)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
        <script src="~/js/event-chat.js"></script>
    }
}