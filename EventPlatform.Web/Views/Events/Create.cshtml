@model EventCreateViewModel

@{
    ViewData["Title"] = "Etkinlik oluştur";
    ViewData["FormAction"] = "Create";
    ViewData["CancelAction"] = "Index";
    ViewData["SubmitText"] = "Etkinliği oluştur";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="mb-3">Etkinlik oluştur</h2>
        <p class="text-muted">Etkinliğiniz oluşturulunca hemen yayınlanır.</p>

        <partial name="_EventForm" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_DatePickerAssets" />

    <style>
        #placeSearch gmp-place-autocomplete {
            display: block;
            width: 100%;
            color-scheme: light;
        }
    </style>

    <script src="~/js/event-form.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=@ViewData["MapsApiKey"]&callback=initMap&loading=async&language=tr&region=TR" async defer></script>
}