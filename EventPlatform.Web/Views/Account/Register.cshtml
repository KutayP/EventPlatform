@model RegisterViewModel

@{
    ViewData["Title"] = "Kayıt ol";
    var genders = new[]
{
    new SelectListItem("Erkek", "Male"),
    new SelectListItem("Kadın", "Female"),
    new SelectListItem("Non-binary", "NonBinary"),
    new SelectListItem("Diğer", "Other")
};
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-3">Kayıt ol</h2>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label">Ad</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label">Soyad</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Kullanıcı adı</label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-posta</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Şifre (en az 8 karakter)</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BirthDate" class="form-label">Doğum tarihi</label>
                    <input asp-for="BirthDate" type="text" class="form-control" autocomplete="off"
                           data-datepicker="birthdate"
                           value="@(Model.BirthDate == default ? "" : Model.BirthDate.ToString("yyyy-MM-dd"))" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Gender" class="form-label">Cinsiyet</label>
                    <select asp-for="Gender" asp-items="genders" class="form-select">
                        <option value="">Seçin</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label">İlgi alanların <span class="text-muted">(isteğe bağlı)</span></label>
                <partial name="_InterestPicker" model="Model.Interests" />
                <span asp-validation-for="SelectedInterestIds" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Kayıt ol</button>
        </form>

        <p class="mt-3 text-center">
            Zaten hesabın var mı? <a asp-action="Login">Giriş yap</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_DatePickerAssets" />
}