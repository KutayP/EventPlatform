@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    // Tema tercihi bu cihazda çerezde tutulur: "light", "dark" ya da (çerez yoksa) "system".
    var themePref = Context.Request.Cookies["ep-theme"];
    if (themePref != "light" && themePref != "dark")
    {
        themePref = "system";
    }

    // Koyu tema paleti (Ayarlar > Görünüm): "default", "slate", "soft", "graphite".
    var palettePref = Context.Request.Cookies["ep-palette"];
    if (palettePref != "slate" && palettePref != "soft" && palettePref != "graphite")
    {
        palettePref = "default";
    }

    // Açık tema paleti: "default", "cream", "mint", "sky".
    var lightPref = Context.Request.Cookies["ep-light"];
    if (lightPref != "cream" && lightPref != "mint" && lightPref != "sky")
    {
        lightPref = "default";
    }
}
<!DOCTYPE html>
<html lang="tr" data-theme-pref="@themePref" data-ep-palette="@palettePref" data-ep-light="@lightPref" data-bs-theme="@(themePref == "dark" ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
        // Sayfa çizilmeden önce çalışır (açık/koyu arasında göz kırpmayı önler). "system": cihaz ayarını izler.
        (function () {
            var d = document.documentElement, pref = d.getAttribute('data-theme-pref');
            var mq = window.matchMedia('(prefers-color-scheme: dark)');
            function apply() {
                d.setAttribute('data-bs-theme', pref === 'dark' || (pref !== 'light' && mq.matches) ? 'dark' : 'light');
            }
            apply();
            if (mq.addEventListener) mq.addEventListener('change', function () { pref = d.getAttribute('data-theme-pref'); apply(); });
            window.epApplyTheme = function (p) { d.setAttribute('data-theme-pref', p); pref = p; apply(); };
            window.epApplyPalette = function (p) { d.setAttribute('data-ep-palette', p); };
            window.epApplyLight = function (p) { d.setAttribute('data-ep-light', p); };
        })();
    </script>
    <title>@ViewData["Title"] - EventPlatform</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%234f46e5'/%3E%3Ctext x='16' y='23' font-size='19' font-family='Arial' font-weight='700' text-anchor='middle' fill='white'%3EE%3C/text%3E%3C/svg%3E" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventPlatform.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg bg-body border-bottom sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">E</span>
                    <span>EventPlatform</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" ? "active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">Ana sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Events" ? "active" : "")"
                               asp-area="" asp-controller="Events" asp-action="Index">Etkinlikler</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @if (EventPlatform.Web.Helpers.DemoAccount.IsDemo(User))
    {
        <div class="bg-warning-subtle text-warning-emphasis border-bottom small py-2">
            <div class="container">
                <i class="bi bi-info-circle me-1"></i>
                <strong>Demo oturumu.</strong>
                Siteyi gönül rahatlığıyla deneyebilirsin. Şifre, kişisel bilgiler ve etkinlik düzenleme/silme bu hesapta kapalı; veriler zaman zaman sıfırlanır.
            </div>
        </div>
    }

    <main role="main" class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer mt-auto">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 EventPlatform</span>
            <a asp-area="" asp-controller="Events" asp-action="Index">Etkinlikler</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>