@model ErrorViewModel

@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <div class="display-1 fw-bold text-primary mb-2">500</div>
    <h1 class="h3 mb-3">Beklenmedik bir hata oluştu</h1>
    <p class="text-muted mb-4">İsteğin işlenirken bir sorun çıktı. Biraz sonra tekrar dene.</p>

    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="text-muted small mb-4">Hata kodu: <code>@Model.RequestId</code></p>
    }

    <div class="d-flex justify-content-center gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfa</a>
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-primary">Etkinlikler</a>
    </div>
</div>