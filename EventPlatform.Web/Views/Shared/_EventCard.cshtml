@model EventListItemViewModel

<div class="card event-card h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="badge category-badge @CategoryStyle.CssClass(Model.Category)">@CategoryStyle.Label(Model.Category)</span>
            <span class="text-muted small" title="Katılımcı sayısı"><i class="bi bi-people"></i> @Model.ParticipantCount</span>
        </div>

        <h5 class="card-title mb-3">
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Eventid" class="stretched-link">@Model.Eventname</a>
        </h5>

        <div class="mt-auto text-muted small">
            <div class="text-truncate mb-1" title="@Model.Location"><i class="bi bi-geo-alt"></i> @Model.Location</div>
            <div>
                <i class="bi bi-calendar-event"></i>
                <time class="js-local" datetime="@(Model.Date.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"))">@Model.Date.ToString("dd.MM.yyyy HH:mm") UTC</time>
            </div>
        </div>
    </div>
</div>