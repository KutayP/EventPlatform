@model PrivacySettingsViewModel

@{
    ViewData["Title"] = "Gizlilik";
    Layout = "_SettingsLayout";
    ViewData["SettingsSection"] = "privacy";
}

<div class="card shadow-sm">
    <div class="card-header">Profil görünürlüğü</div>
    <div class="card-body">
        <form asp-action="Privacy" method="post">
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="visibility" id="vis-public"
                       value="@ProfileVisibilities.Public" checked="@(Model.ProfileVisibility == ProfileVisibilities.Public)" />
                <label class="form-check-label" for="vis-public">
                    <strong>Herkese açık</strong>
                    <span class="d-block text-muted small">Profil sayfamı herkes görebilir.</span>
                </label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="visibility" id="vis-friends"
                       value="@ProfileVisibilities.Friends" checked="@(Model.ProfileVisibility == ProfileVisibilities.Friends)" />
                <label class="form-check-label" for="vis-friends">
                    <strong>Yalnızca arkadaşlarım</strong>
                    <span class="d-block text-muted small">Yalnızca arkadaşlarım ve yöneticiler görebilir.</span>
                </label>
            </div>
            <p class="text-muted small">E-posta, doğum tarihi ve cinsiyet bu ayardan bağımsız olarak hiçbir zaman başkalarına gösterilmez.</p>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-controller="Users" asp-action="Profile" asp-route-username="@Model.Username" class="btn btn-outline-secondary">Profil sayfamı gör</a>
            </div>
        </form>
    </div>
</div>
